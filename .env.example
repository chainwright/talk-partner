# Copy to .env.local (gitignored). Values come from Firebase console > Project settings > Your apps > Web app.
# The web config is a public client identifier, but we still keep it out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=talk-partner.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talk-partner
VITE_FIREBASE_APP_ID=
# Local development only: an App Check debug token registered in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
# Deployed site: reCAPTCHA Enterprise site key registered as the App Check provider.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
