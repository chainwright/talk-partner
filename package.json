{
  "name": "talk-partner",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Talk Partner turns a partner's question into a supported-conversation card for an adult with aphasia. All AI runs through Firebase AI Logic hybrid inference (on-device Gemini Nano when available, cloud otherwise).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e:cloud": "node scripts/e2e-cloud.mjs",
    "e2e:noconfig": "node scripts/e2e-noconfig.mjs",
    "e2e:ondevice": "node scripts/e2e-ondevice.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
